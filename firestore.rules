rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string
        && data.email is string
        && data.email.size() <= 200;
    }

    function isValidPresentation(data) {
      return data.ownerId is string
        && data.title is string
        && data.title.size() <= 200
        && data.slides is list
        && data.slides.size() <= 500;
    }

    function isValidSavedRoom(data) {
      return data.ownerId is string
        && data.roomCode is string
        && data.roomCode.size() <= 20
        && data.presentationTitle is string
        && data.presentationTitle.size() <= 200;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().uid == userId
                    && isValidUserProfile(incoming());
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().uid == userId
                    && incoming().uid == existing().uid
                    && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      // User presentations subcollection
      match /presentations/{presentationId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(presentationId)
                      && incoming().ownerId == userId
                      && isValidPresentation(incoming());
        allow update: if isOwner(userId)
                      && isValidId(presentationId)
                      && incoming().ownerId == userId
                      && incoming().ownerId == existing().ownerId
                      && isValidPresentation(incoming());
        allow delete: if isOwner(userId) && isValidId(presentationId);
      }

      // User saved rooms subcollection
      match /rooms/{roomId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(roomId)
                      && incoming().ownerId == userId
                      && isValidSavedRoom(incoming());
        allow update: if isOwner(userId)
                      && isValidId(roomId)
                      && incoming().ownerId == userId
                      && incoming().ownerId == existing().ownerId
                      && isValidSavedRoom(incoming());
        allow delete: if isOwner(userId) && isValidId(roomId);
      }
    }
  }
}
