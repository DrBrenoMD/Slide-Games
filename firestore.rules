rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().uid == userId
                    && incoming().email is string
                    && incoming().keys().hasAll(['uid', 'email'])
                    && incoming().keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']);
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().uid == userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isOwner(userId);

      // User presentations subcollection
      match /presentations/{presentationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(presentationId)
                      && incoming().ownerId == userId
                      && incoming().title is string
                      && incoming().title.size() > 0
                      && incoming().title.size() <= 200
                      && incoming().slides is list
                      && incoming().slides.size() <= 200;
        allow update: if isOwner(userId)
                      && isValidId(presentationId)
                      && incoming().ownerId == userId
                      && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'slides', 'theme', 'slideCount', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(presentationId);
      }

      // User saved rooms subcollection
      match /rooms/{roomId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(roomId)
                      && incoming().ownerId == userId
                      && incoming().roomCode is string
                      && incoming().roomCode.size() <= 20
                      && incoming().presentationTitle is string
                      && incoming().presentationTitle.size() <= 200;
        allow update: if isOwner(userId)
                      && isValidId(roomId)
                      && incoming().ownerId == userId
                      && incoming().diff(existing()).affectedKeys().hasOnly(['presentationTitle', 'presentationId', 'slides', 'participantsCount', 'status', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(roomId);
      }
    }
  }
}
